# Database
DATABASE_URL="postgresql://user:password@localhost:5432/behrio"

# Prisma + server
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Admin bootstrap (used by scripts/create-admin.ts only)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Email OTP (SMTP via nodemailer)
# Enabling requires both SMTP_USER and SMTP_PASS (or SMTP_ORG credentials).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Behrio <no-reply@example.com>"

# Legacy names (optional, fallback used by older flows)
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Cron (protects /api/cron/settlement)
CRON_SECRET="generate-a-long-random-string"

# Storage driver: "local" (default) or "s3"
STORAGE_DRIVER="local"
# Required when STORAGE_DRIVER="s3"
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
# Optional S3 overrides
STORAGE_REGION=""
STORAGE_ENDPOINT=""
STORAGE_PUBLIC_BASE_URL=""

# Rate limiter: "memory" (default, single-instance) or "redis"
# When "redis", set UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN
RATE_LIMITER_DRIVER="memory"